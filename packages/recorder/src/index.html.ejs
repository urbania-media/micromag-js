<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Micromag</title>
        <style type="text/css">
            body, html, #root {
                margin: 0;
                padding: 0;
                height: 100%;
                width: 100%;
            }

            body {
                background: #000;
            }

            .micromag {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }
        </style>
    </head>
    <body>
        <div id="root"></div>
    </body>
</html>
