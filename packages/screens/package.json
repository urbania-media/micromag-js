{
    "name": "@micromag/screens",
    "version": "0.4.108",
    "private": false,
    "description": "",
    "keywords": [
        "javascript"
    ],
    "homepage": "https://github.com/urbania-media/micromag-js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/urbania-media/micromag-js.git"
    },
    "license": "ISC",
    "author": {
        "name": "Folklore",
        "email": "info@folklore.email"
    },
    "contributors": [
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@folklore.email"
        },
        {
            "name": "Nicolas Roy-Bourdages",
            "email": "nrb@folklore.email"
        },
        {
            "name": "Julien Carignan",
            "email": "jc@folklore.email"
        }
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "style": "./assets/css/styles.css",
            "import": "./es/index.js"
        },
        "./all": {
            "types": "./es/all.d.ts",
            "require": "./lib/all.js",
            "import": "./es/all.js"
        },
        "./fields": "./fields.js",
        "./fields.json": "./fields.json",
        "./assets/css/styles": "./assets/css/styles.css",
        "./assets/css/styles.css": "./assets/css/styles.css"
    },
    "module": "es/index.js",
    "browser": {
        ".": "./es/index.js",
        "./all": "./es/all.js"
    },
    "types": "es/index.d.ts",
    "style": "assets/css/styles.css",
    "files": [
        "lib",
        "es",
        "assets",
        "fields.js",
        "fields.json",
        "all.js"
    ],
    "scripts": {
        "aggregate-css": "../../scripts/build-packages-styles.js --pattern='@micromag/screen-*' ./src/styles.css.ejs ./assets/css/styles.css",
        "all-styles": "npm run aggregate-css && npm run build-css",
        "build": "npm run build:fields && ../../scripts/prepare-package.sh --types && npm run aggregate-css && npm run build-css",
        "build:fields": "NODE_ENV=development rollup --bundleConfigAsCjs --config ./rollup.config.cli.js && node ./build-screen-fields.cjs ./ && rm -f ./build-screen-fields.cjs",
        "build-css": "../../scripts/build-css.js ./assets/css/styles.css ./assets/css/build.css",
        "clean": "rm -rf es && rm -rf lib && rm -rf assets && rm -rf styles && rm -rf fields.js && rm -rf fields.json",
        "node": "../../node_modules/.bin/babel-node --config-file=../../babel.config.js  --ignore='[]' --env-name=node --no-babelrc",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@babel/runtime": "^7.28.6",
        "@micromag/core": "^0.4.108",
        "@micromag/screen-article": "^0.4.108",
        "@micromag/screen-audio": "^0.4.108",
        "@micromag/screen-contribution": "^0.4.108",
        "@micromag/screen-conversation": "^0.4.108",
        "@micromag/screen-gallery": "^0.4.108",
        "@micromag/screen-gallery-feed": "^0.4.108",
        "@micromag/screen-game-sort": "^0.4.108",
        "@micromag/screen-image": "^0.4.108",
        "@micromag/screen-keypad": "^0.4.108",
        "@micromag/screen-map": "^0.4.108",
        "@micromag/screen-quiz": "^0.4.108",
        "@micromag/screen-quote": "^0.4.108",
        "@micromag/screen-ranking": "^0.4.108",
        "@micromag/screen-share": "^0.4.108",
        "@micromag/screen-slideshow": "^0.4.108",
        "@micromag/screen-survey": "^0.4.108",
        "@micromag/screen-text": "^0.4.108",
        "@micromag/screen-timeline": "^0.4.108",
        "@micromag/screen-title": "^0.4.108",
        "@micromag/screen-urbania-article": "^0.4.108",
        "@micromag/screen-urbania-horoscope": "^0.4.108",
        "@micromag/screen-urbania-recommendation": "^0.4.108",
        "@micromag/screen-urbania-trivia": "^0.4.108",
        "@micromag/screen-video": "^0.4.108",
        "@micromag/screen-video-360": "^0.4.108",
        "classnames": "^2.2.6",
        "lodash-es": "^4.17.23"
    },
    "devDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "gitHead": "b0211288ab404ca6361f1c9b80d99f56f5dfeb38"
}
