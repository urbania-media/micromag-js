        "es",
        "lib"
    ],
    "scripts": {
        "build": "rm -rf dist && ../../scripts/prepare-package.sh && npm run build:ckeditor",
        "build:ckeditor": "../../node_modules/.bin/webpack --mode production --config webpack.config.cjs",
        "clean": "rm -rf es && rm -rf lib && rm -rf dist",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
