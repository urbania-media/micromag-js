    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.js"
        },
        "./locale": "./locale",
        "./locale/fr.json": "./locale/fr.json",
        "./locale/en.json": "./locale/en.json",
        "./locale/fr": {
            "types": "./locale/fr.d.ts",
            "import": "./locale/fr.js"
        },
        "./locale/en": {
            "types": "./locale/en.d.ts",
            "import": "./locale/en.js"
        }
    },
    "files": [
        "locale",
        "lib",
        "es",
        "scripts",
        "assets"
    ],
    "scripts": {
        "clean": "rm -rf es && rm -rf lib && rm -rf assets && rm -rf styles",
        "intl": "../../scripts/build-intl.js '../../!(node_modules)/!(intl)/src/**/*.+(js|jsx|ts|tsx)' --ast",
        "prepublishOnly": "npm run build",
        "build": "rm -rf ./locale && npm run intl && ../../scripts/prepare-package.sh --types"
    },
    "devDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
