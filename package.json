{
    "name": "micromag-js",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "imports": {
        "#.storybook/*": "./.storybook/*"
    },
    "workspaces": [
        "elements/*",
        "screens/*",
        "packages/*"
    ],
    "scripts": {
        "storybook": "storybook dev --port 58800",
        "start": "npm run storybook",
        "server": "npm run storybook",
        "intl:tx-config": "./scripts/tx-config.js",
        "output-static": "NODE_ENV=node BABEL_ENV=node babel-node ./scripts/output-static.js",
        "intl": "npm run intl --workspace=@micromag/intl",
        "build": "npm run build:all",
        "build:all": "nx run-many --target=build",
        "build:linear": "nx run-many --target=build --parallel=false",
        "build:nocache": "nx run-many --target=build --skip-nx-cache --parallel=false",
        "build:viewer": "npm run build --workspace=@micromag/viewer-build",
        "graph": "nx graph",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch",
        "update-panneau": "npm update @panneau/core @panneau/medias @panneau/intl @panneau/uppy @panneau/fields @panneau/displays @panneau/filters"
    },
