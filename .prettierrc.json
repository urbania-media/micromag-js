{
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "importOrder": [
        "\\.global\\.css$",
        "<THIRD_PARTY_MODULES>",
        "^@panneau/(.*)$",
        "^@micromag/(.*)$",
        "^[./](.*)?/(utils|hooks|lib)",
        "^[./].*(?<!(\\.[a-z]+))$",
        "\\.css$",
        "\\/(.+)\\.[a-z]+$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}
